@page "/library"
@inject HttpClient Http
<h2>Library</h2>
<p class="hint">Media connections and synced libraries. Manage connections, sync libraries, and browse the catalog.</p>

<!-- Connection tabs -->
@if (connections is not null && connections.Count > 0)
{
    <div class="inner-tabs" style="margin-bottom:1rem;">
        @foreach (var c in connections)
        {
            <button class="inner-tab @(selectedConn?.Id == c.Id ? "active" : "")" @onclick="() => SelectConnection(c)">@(!string.IsNullOrEmpty(c.Name) ? c.Name : $"Connection {c.Id}")</button>
        }
    </div>
}

@if (selectedConn is not null)
{
    <div class="panel" style="margin-bottom:1rem;">
        <div class="panel-head">
            <h2>@(!string.IsNullOrEmpty(selectedConn.Name) ? selectedConn.Name : $"Connection {selectedConn.Id}")</h2>
            <span class="count">@libraries.Count libraries</span>
        </div>
        <p class="hint">Kind: @selectedConn.Kind</p>

        @if (loadingLibs) { <p>Loading libraries...</p> }
        else if (libraries.Count == 0) { <p class="empty">No libraries found. Check the connection.</p> }
        else
        {
            <table style="width:100%;border-collapse:collapse;">
                <thead><tr><th></th><th>Name</th><th>ID</th><th>Type</th></tr></thead>
                <tbody>
                @foreach (var lib in libraries)
                {
                    <tr>
                        <td><input type="checkbox" @bind="lib.Selected" /></td>
                        <td>@lib.Name</td>
                        <td><code>@lib.Id</code></td>
                        <td>@lib.CollectionType</td>
                    </tr>
                }
                </tbody>
            </table>
            <div style="margin-top:1rem;display:flex;gap:.5rem;">
                <button class="ghost" @onclick="TestConn" disabled="@testing">@(testing ? "Testing..." : "Test Connection")</button>
                <button class="primary" @onclick="SyncSelected" disabled="@syncing">@(syncing ? "Syncing..." : "Sync Selected")</button>
            </div>
            @if (!string.IsNullOrEmpty(testResult)) { <p class="field-note" style="color:@(testResult.StartsWith("OK")?"var(--ok)":"var(--danger)")">@testResult</p> }
            @if (!string.IsNullOrEmpty(syncResult)) { <p class="field-note">@syncResult</p> }
        }
    </div>
}
else if (connections is null || connections.Count == 0)
{
    <div class="panel" style="margin-bottom:1rem;">
        <p class="empty">No connections. Add one on the <a href="/connections" class="link">Connections</a> page.</p>
    </div>
}

<div class="panel">
    <div class="panel-head">
        <h2>Catalog</h2>
        <span class="count">@mediaCount items</span>
    </div>
    <p class="hint">The items your media sources have synced.</p>
    <a href="/media" class="link">Browse full catalog →</a>
</div>
@code {
    private List<ConnDto>? connections;
    private ConnDto? selectedConn;
    private List<LibraryDto> libraries = new();
    private bool loadingLibs, syncing, testing;
    private string? syncResult, testResult;
    private int mediaCount;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            connections = await Http.GetFromJsonAsync<List<ConnDto>>("api/connections", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (connections is not null && connections.Count > 0 && selectedConn is null)
                await SelectConnection(connections[0]);
            var catalog = await Http.GetFromJsonAsync<CatalogResponse>("api/media/catalog?limit=1", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            mediaCount = catalog?.Count ?? 0;
        }
        catch { connections = new(); }
    }

    private async Task SelectConnection(ConnDto c)
    {
        selectedConn = c;
        libraries = new();
        loadingLibs = true;
        try
        {
            var libs = await Http.GetFromJsonAsync<List<LibraryDto>>($"api/media/libraries/{c.Id}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (libs is not null)
                foreach (var l in libs) { l.Selected = false; libraries.Add(l); }
        }
        catch { libraries = new(); }
        loadingLibs = false;
    }

    private async Task TestConn()
    {
        if (selectedConn is null) return;
        testing = true;
        testResult = null;
        try
        {
            Dictionary<string, string> config;
            try { config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(selectedConn.ConfigJson) ?? new(); }
            catch { config = new(); }
            var url = config.TryGetValue("url", out var u) ? u : "";
            var apiKey = config.TryGetValue("apiKey", out var k) ? k : "";
            var res = await Http.PostAsJsonAsync("api/media/test-jellyfin", new { Url = url, ApiKey = apiKey });
            var body = await res.Content.ReadAsStringAsync();
            testResult = res.IsSuccessStatusCode ? "OK: " + body : "Error: " + body;
        }
        catch (Exception e) { testResult = "Error: " + e.Message; }
        testing = false;
    }

    private async Task SyncSelected()
    {
        if (selectedConn is null) return;
        var selected = libraries.Where(l => l.Selected).Select(l => l.Id).ToList();
        if (selected.Count == 0) { syncResult = "No libraries selected."; return; }
        syncing = true;
        syncResult = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/media/sync-libraries", new { ConnectionId = selectedConn.Id, LibraryIds = selected });
            syncResult = await res.Content.ReadAsStringAsync();
            await Load();
        }
        catch (Exception e) { syncResult = "Error: " + e.Message; }
        syncing = false;
    }

    public record ConnDto(int Id, string Name, string Kind, string ConfigJson);
    public class LibraryDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string CollectionType { get; set; } = "";
        public bool Selected { get; set; }
    }
    public class CatalogResponse { public int Count { get; set; } }
}
