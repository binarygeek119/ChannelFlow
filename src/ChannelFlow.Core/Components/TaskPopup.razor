@implements IDisposable
@inject HttpClient Http
<div class="task-popup-wrap">
    @foreach (var t in tasks)
    {
        <div class="task-popup @(t.Status == "done" ? "status-done fading" : t.Status == "failed" ? "status-fail fading" : "")">
            <div class="task-popup-head">@t.Title</div>
            @if (!string.IsNullOrEmpty(t.Label)) { <div class="task-popup-status">@t.Label</div> }
            <div class="task-popup-track">
                <div class="task-popup-bar @(t.Total == 0 ? "indeterminate" : t.Status == "done" ? "done" : t.Status == "failed" ? "fail" : "")" style="width:@(t.Total > 0 ? (t.Current * 100 / t.Total) : 45)%"></div>
            </div>
            <div class="task-popup-status">@t.Current / @t.Total</div>
            @if (!string.IsNullOrEmpty(t.Detail)) { <div class="task-popup-status" style="font-size:.85rem;">@t.Detail</div> }
        </div>
    }
</div>
@code {
    private List<TaskDto> tasks = new();
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        cts = new CancellationTokenSource();
        _ = PollLoop(cts.Token);
    }

    private async Task PollLoop(CancellationToken ct)
    {
        // Poll immediately on init
        await Poll();
        while (!ct.IsCancellationRequested)
        {
            try { await Task.Delay(2000, ct); } catch (TaskCanceledException) { break; }
            await Poll();
        }
    }

    private async Task Poll()
    {
        try
        {
            var running = await Http.GetFromJsonAsync<List<TaskDto>>("api/tasks/running", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            tasks = running ?? new();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    public class TaskDto
    {
        public string Key { get; set; } = "";
        public string Title { get; set; } = "";
        public string? Label { get; set; }
        public long Current { get; set; }
        public long Total { get; set; }
        public string Status { get; set; } = "running";
        public string? Detail { get; set; }
    }
}
