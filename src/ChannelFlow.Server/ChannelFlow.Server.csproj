<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinTv</RootNamespace>
    <AssemblyName>ChannelFlow.Server</AssemblyName>
    <Authors>binarygeek119</Authors>
    <Product>ChannelFlow-Server</Product>
    <AssemblyTitle>ChannelFlow-Server</AssemblyTitle>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChannelFlow.CommercialDetect\ChannelFlow.CommercialDetect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\vendor\ws4kp\server\fonts\*" Link="weatherstar\ws4kp\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws4kp\server\fonts')" />
    <None Include="..\..\vendor\ws4kp\server\images\backgrounds\*" Link="weatherstar\ws4kp\images\backgrounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws4kp\server\images\backgrounds')" />
    <None Include="..\..\vendor\ws4kp\server\images\icons\current-conditions\*" Link="weatherstar\ws4kp\images\icons\current-conditions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws4kp\server\images\icons\current-conditions')" />
    <None Include="..\..\vendor\ws4kp\server\images\maps\radar\*" Link="weatherstar\ws4kp\images\maps\radar\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws4kp\server\images\maps\radar')" />
    <None Include="..\..\vendor\ws4kp\server\music\default\*" Link="weatherstar\ws4kp\music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws4kp\server\music\default')" />
    <None Include="..\..\vendor\ws3kp\server\fonts\*.ttf" Link="weatherstar\ws3kp\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws3kp\server\fonts')" />
    <None Include="..\..\vendor\ws3kp\server\images\backgrounds\*" Link="weatherstar\ws3kp\images\backgrounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\vendor\ws3kp\server\images\backgrounds')" />
    <None Include="Music\music-packs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyAppLogo" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <BrandLogo Include="$(MSBuildThisFileDirectory)..\..\logo.png" Condition="Exists('$(MSBuildThisFileDirectory)..\..\logo.png')" />
      <BrandLogo Include="$(MSBuildThisFileDirectory)..\..\logo-plane.png" Condition="Exists('$(MSBuildThisFileDirectory)..\..\logo-plane.png')" />
    </ItemGroup>
    <Copy SourceFiles="@(BrandLogo)" DestinationFolder="$(MSBuildThisFileDirectory)wwwroot" />
  </Target>

</Project>
