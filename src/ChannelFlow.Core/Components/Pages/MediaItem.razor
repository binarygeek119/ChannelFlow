@page "/media/item/{matchKey}"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager Nav

@if (loading) { <p>Loading...</p> }
else if (item is null) { <p class="empty">That item isn't in the catalog any more.</p> }
else
{
    <!-- Backdrop -->
    @if (!string.IsNullOrEmpty(item.PosterUrl))
    {
        <div style="position:relative;height:300px;overflow:hidden;margin:-1rem -1.5rem 1rem;background:var(--card-bg);">
            <img src="@item.PosterUrl" style="width:100%;height:100%;object-fit:cover;filter:blur(8px) brightness(.4);" />
            <div style="position:absolute;inset:0;background:linear-gradient(to top, var(--page-bg), transparent 60%);"></div>
        </div>
    }

    <button class="ghost" @onclick="Back">← Back to Media</button>

    <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1rem;">
        @if (!string.IsNullOrEmpty(item.PosterUrl))
        {
            <div style="position:relative;display:inline-block;">
                <img src="@item.PosterUrl" alt="@item.Title" style="max-width:220px;border-radius:8px;align-self:flex-start;box-shadow:0 4px 16px rgba(0,0,0,.4);" onerror="this.src='/images/poster-placeholder.svg'" />
                @if (!string.IsNullOrEmpty(item.WebUrl))
                {
                    <a href="@item.WebUrl" target="_blank" rel="noopener" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(225,29,72,.7);color:#fff;border-radius:50%;width:56px;height:56px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,.4);opacity:0;transition:opacity .2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0" title="Play on @item.SourceKind">▶</a>
                }
            </div>
        }
        else
        {
            <div style="position:relative;display:inline-block;">
                <img src="/images/poster-placeholder.svg" alt="@item.Title" style="max-width:220px;border-radius:8px;align-self:flex-start;box-shadow:0 4px 16px rgba(0,0,0,.4);" />
                @if (!string.IsNullOrEmpty(item.WebUrl))
                {
                    <a href="@item.WebUrl" target="_blank" rel="noopener" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(225,29,72,.7);color:#fff;border-radius:50%;width:56px;height:56px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,.4);opacity:0;transition:opacity .2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0" title="Play on @item.SourceKind">▶</a>
                }
            </div>
        }
        <div style="flex:1;min-width:300px;">
            <h1 style="margin-top:0;">@item.Title</h1>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem;align-items:center;">
                @if (item.Year.HasValue) { <span style="color:var(--muted);font-size:1.1rem;">@item.Year</span> }
            @if (!string.IsNullOrEmpty(item.SourceKind))
            {
                <img src="/logos/@(item.SourceKind.ToLowerInvariant() switch { "jellyfin" => "Jellyfin", "plex" => "Plex", "emby" => "Emby", "local" => "LOCAL", _ => item.SourceKind } + ".png")" alt="@item.SourceKind" style="height:20px;opacity:.8;" onerror="this.style.display='none'" />
            }
                @if (!string.IsNullOrEmpty(item.OfficialRating)) { <span class="pill off">@item.OfficialRating</span> }
                @if (item.RuntimeMs.HasValue) { <span class="pill off">@(item.RuntimeMs.Value / 60000) min</span> }
                <span class="pill off">@item.Kind</span>
                @if (!string.IsNullOrEmpty(item.WebUrl))
                {
                    <a href="@item.WebUrl" target="_blank" rel="noopener" class="primary" style="display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;margin-left:.5rem;">▶ Play on @item.SourceKind</a>
                }
            </div>
            @if (item.Genres.Count > 0)
            {
                <div style="margin-bottom:.75rem;">
                    @foreach (var g in item.Genres) { <span class="pill on" style="margin-right:.3rem;">@g</span> }
                </div>
            }
            @if (!string.IsNullOrEmpty(item.Overview))
            {
                <p style="line-height:1.6;color:var(--text);">@item.Overview</p>
            }
            @if (item.Tags.Count > 0)
            {
                <p class="hint"><strong>Tags:</strong> @string.Join(", ", item.Tags)</p>
            }
            @if (item.Kind == "series")
            {
                <h3 style="margin-top:1.5rem;">Seasons</h3>
                @if (seasons.Count == 0) { <p class="hint">No seasons synced yet.</p> }
                else
                {
                    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                        @foreach (var season in seasons)
                        {
                            <button class="ghost @(selectedSeasonId == season.SeasonId ? "active" : "")" @onclick="() => SelectSeason(season)" style="padding:0;overflow:hidden;border-radius:8px;min-width:100px;">
                                <div style="width:100px;aspect-ratio:2/3;background:var(--card-bg);position:relative;overflow:hidden;">
                                    @if (!string.IsNullOrEmpty(season.PosterUrl))
                                    {
                                        <img src="@season.PosterUrl" alt="@season.SeasonName" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/poster-placeholder.svg'" />
                                    }
                                    else
                                    {
                                        <img src="/images/poster-placeholder.svg" alt="@season.SeasonName" style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    <div style="position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.7);color:#fff;font-size:.75rem;padding:.2rem;text-align:center;">@(season.SeasonName ?? $"Season {season.SeasonId}")</div>
                                </div>
                            </button>
                        }
                    </div>
                }

                @if (selectedSeasonId is not null)
                {
                    <h4>Episodes</h4>
                    @if (FilteredEpisodes.Count == 0) { <p class="hint">No episodes in this season.</p> }
                    else
                    {
                        <table style="width:100%;border-collapse:collapse;">
                            <thead><tr><th style="width:120px;">Thumbnail</th><th>Title</th><th>Year</th></tr></thead>
                            <tbody>
                            @foreach (var ep in FilteredEpisodes)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(ep.PosterUrl))
                                        {
                                            <img src="@ep.PosterUrl" alt="@ep.Title" style="width:120px;height:68px;object-fit:cover;border-radius:4px;" onerror="this.src='/images/poster-placeholder.svg'" />
                                        }
                                        else
                                        {
                                            <img src="/images/poster-placeholder.svg" alt="@ep.Title" style="width:120px;height:68px;object-fit:cover;border-radius:4px;" />
                                        }
                                    </td>
                                    <td><a href="/media/item/@Uri.EscapeDataString(ep.MatchKey)" class="link">@ep.Title</a></td>
                                    <td>@ep.Year</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }
            }

            @if (collectionMovies.Count > 0)
            {
                <h3 style="margin-top:1.5rem;">Movies in this Collection (@collectionMovies.Count)</h3>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;">
                    @foreach (var cm in collectionMovies)
                    {
                        <a href="/media/item/@Uri.EscapeDataString(cm.MatchKey)" data-enhance-nav="false" style="text-decoration:none;color:inherit;display:block;">
                            <div style="aspect-ratio:2/3;background:var(--card-bg);border-radius:var(--radius);overflow:hidden;margin-bottom:.5rem;">
                                @if (!string.IsNullOrEmpty(cm.PosterUrl))
                                {
                                    <img src="@cm.PosterUrl" alt="@cm.Title" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/poster-placeholder.svg'" />
                                }
                                else
                                {
                                    <img src="/images/poster-placeholder.svg" alt="@cm.Title" style="width:100%;height:100%;object-fit:cover;" />
                                }
                            </div>
                            <div style="font-size:.9rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@cm.Title</div>
                            @if (cm.Year.HasValue) { <div style="font-size:.75rem;color:var(--muted);">@cm.Year</div> }
                        </a>
                    }
                </div>
            }

            @if (credits.Count > 0)
            {
                <h3 style="margin-top:1.5rem;">Cast & Crew</h3>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:1rem;">
                    @foreach (var c in credits)
                    {
                        <div style="text-align:center;">
                            <div style="width:80px;height:80px;margin:0 auto;border-radius:50%;background:var(--card-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid var(--border);">
                                @if (!string.IsNullOrEmpty(c.ImagePath))
                                {
                                    <img src="@c.ImagePath" alt="@c.Role" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/person-placeholder.svg'" />
                                }
                                else
                                {
                                    <img src="/images/person-placeholder.svg" alt="@c.Role" style="width:100%;height:100%;object-fit:cover;" />
                                }
                            </div>
                            <div style="margin-top:.4rem;font-size:.85rem;font-weight:600;"><a href="/people/@Uri.EscapeDataString(string.IsNullOrEmpty(c.PersonName) ? c.Role : c.PersonName)" class="link">@(string.IsNullOrEmpty(c.PersonName) ? c.Role : c.PersonName)</a></div>
                            @if (!string.IsNullOrEmpty(c.Character)) { <div style="font-size:.75rem;color:var(--muted);">@c.Character</div> }
                            @if (!string.IsNullOrEmpty(c.Role) && !string.IsNullOrEmpty(c.PersonName)) { <div style="font-size:.7rem;color:var(--muted);">@c.Role</div> }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
@code {
    [Parameter] public string matchKey { get; set; } = "";
    private MediaItemDto? item;
    private List<CreditDto> credits = new();
    private List<MediaItemDto> collectionMovies = new();
    private List<MediaItemDto> episodes = new();
    private List<MediaItemDto> seasons = new();
    private string? selectedSeasonId;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<MediaDetail>($"api/media/{Uri.EscapeDataString(matchKey)}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null)
            {
                item = res.Item;
                credits = res.Credits ?? new();
                if (item?.CollectionItems is { Count: > 0 })
                {
                    try
                    {
                        var collRes = await Http.GetFromJsonAsync<CollectionResponse>($"api/media/collection/{Uri.EscapeDataString(matchKey)}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (collRes?.Children is not null)
                        {
                            foreach (var ch in collRes.Children)
                            {
                                collectionMovies.Add(new MediaItemDto { MatchKey = ch.MatchKey, Title = ch.Title, Year = ch.Year, PosterUrl = ch.PosterUrl });
                            }
                        }
                    }
                    catch { }
                }
                // Load episodes and seasons for series
                if (item is not null && item.Kind == "series")
                {
                    try
                    {
                        var epRes = await Http.GetFromJsonAsync<EpisodesResponse>($"api/media/episodes/{Uri.EscapeDataString(matchKey)}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (epRes is not null && epRes.Items is not null)
                        {
                            foreach (var e in epRes.Items.OrderBy(e => e.Title))
                            {
                                episodes.Add(new MediaItemDto { MatchKey = e.MatchKey, Title = e.Title, Year = e.Year, PosterUrl = e.PosterUrl, SeasonId = e.SeasonId, SeasonName = e.SeasonName });
                            }
                            // Build seasons list
                            seasons = episodes
                                .GroupBy(e => e.SeasonId ?? e.SeasonName ?? "1")
                                .Select(g => new MediaItemDto { MatchKey = "", Kind = "season", Title = g.First().SeasonName ?? $"Season {g.Key}", SeasonId = g.Key, SeasonName = g.First().SeasonName, PosterUrl = g.First().PosterUrl })
                                .ToList();
                            if (seasons.Count > 0) selectedSeasonId = seasons[0].SeasonId;
                        }
                    }
                    catch { }
                }
            }
        }
        catch { item = null; }
        loading = false;
    }

    private void Back() => Nav.NavigateTo("/media");
    private void SelectSeason(MediaItemDto season) => selectedSeasonId = season.SeasonId;
    private List<MediaItemDto> FilteredEpisodes => episodes.Where(e => (e.SeasonId ?? e.SeasonName ?? "1") == selectedSeasonId).ToList();

    private static string Initials(string name) =>
        string.Join("", (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));

    public class MediaDetail
    {
        public MediaItemDto? Item { get; set; }
        public List<CreditDto> Credits { get; set; } = new();
    }
    public class MediaItemDto
    {
        public string MatchKey { get; set; } = "";
        public string Kind { get; set; } = "";
        public string Title { get; set; } = "";
        public int? Year { get; set; }
        public long? RuntimeMs { get; set; }
        public List<string> Genres { get; set; } = new();
        public string? OfficialRating { get; set; }
        public string? PosterUrl { get; set; }
        public string? WebUrl { get; set; }
        public string? SourceKind { get; set; }
        public string? Overview { get; set; }
        public string? SeriesName { get; set; }
        public string? SeriesId { get; set; }
        public string? SeasonName { get; set; }
        public string? SeasonId { get; set; }
        public List<string> Tags { get; set; } = new();
        public List<string>? CollectionItems { get; set; }
    }
    public class CatalogResponse { public List<MediaItemDto> Items { get; set; } = new(); public int Count { get; set; } }
    public class CollectionChildDto
    {
        public string MatchKey { get; set; } = "";
        public string Title { get; set; } = "";
        public int? Year { get; set; }
        public string? PosterUrl { get; set; }
    }
    public class EpisodeDto
    {
        public string MatchKey { get; set; } = "";
        public string Title { get; set; } = "";
        public int? Year { get; set; }
        public string? SeasonId { get; set; }
        public string? SeasonName { get; set; }
        public string? PosterUrl { get; set; }
        public string? WebUrl { get; set; }
    }
    public class EpisodesResponse
    {
        public List<EpisodeDto> Items { get; set; } = new();
        public int Count { get; set; }
    }
    public class CollectionResponse
    {
        public List<CollectionChildDto> Children { get; set; } = new();
    }
    public class CreditDto
    {
        public Guid Id { get; set; }
        public Guid PersonId { get; set; }
        public string PersonName { get; set; } = "";
        public string? ImagePath { get; set; }
        public string MediaMatchKey { get; set; } = "";
        public string Role { get; set; } = "";
        public string? Character { get; set; }
    }
}
