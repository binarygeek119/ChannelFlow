@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@page "/media"
@rendermode RenderMode.InteractiveServer
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
<div class="inner-tabs" style="margin-bottom:1rem;">
    @foreach (var tab in tabs)
    {
        <button class="inner-tab @(activeTab == tab ? "active" : "")" @onclick="() => SwitchTab(tab)">@tab</button>
    }
</div>

<!-- A-Z quick jump bar -->
<div style="display:flex;flex-wrap:wrap;gap:.25rem;margin-bottom:1rem;">
    <button class="ghost" style="min-width:32px;padding:.2rem .4rem;@(filterLetter == "" ? "background:var(--accent);color:#fff;" : "")" @onclick='() => SetFilter("")'>All</button>
    @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray())
    {
        <button class="ghost" style="min-width:32px;padding:.2rem .4rem;@(filterLetter == letter.ToString() ? "background:var(--accent);color:#fff;" : "")" @onclick="() => SetFilter(letter.ToString())">@letter</button>
    }
</div>

@if (loading) { <p>Loading...</p> }
else if (items.Count == 0) { <p class="empty">No items in this category.</p> }
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;">
        @foreach (var it in FilteredItems)
        {
            var _it = it;
            <div class="card jf-card" style="cursor:pointer;position:relative;" title="@_it.Title" @onclick="() => OpenItem(_it.MatchKey)">
                <div style="aspect-ratio:2/3;background:var(--card-bg);border-radius:var(--radius);overflow:hidden;margin-bottom:.5rem;">
                    @if (!string.IsNullOrEmpty(_it.PosterUrl))
                    {
                        <img src="@_it.PosterUrl" alt="@_it.Title" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/poster-placeholder.svg'" />
                    }
                    else
                    {
                        <img src="/images/poster-placeholder.svg" alt="@_it.Title" style="width:100%;height:100%;object-fit:cover;" />
                    }
                </div>
                @if (!string.IsNullOrEmpty(_it.WebUrl))
                {
                    <a href="@_it.WebUrl" target="_blank" rel="noopener" @onclick:stopPropagation="true" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(225,29,72,.7);color:#fff;border-radius:50%;width:48px;height:48px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.2rem;box-shadow:0 2px 8px rgba(0,0,0,.4);opacity:0;transition:opacity .2s;pointer-events:auto;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0" title="Play on @_it.SourceKind">▶</a>
                }
                <div class="cardText cardText-first" style="font-size:.9rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@_it.Title</div>
                <div class="cardText cardText-secondary" style="font-size:.75rem;color:var(--muted);">@(_it.Year?.ToString() ?? _it.Kind)</div>
                @if (!string.IsNullOrEmpty(_it.SourceKind))
                {
                    <div style="margin-top:.25rem;">
                        <img src="/logos/@(_it.SourceKind.ToLowerInvariant() switch { "jellyfin" => "Jellyfin", "plex" => "Plex", "emby" => "Emby", "local" => "LOCAL", _ => _it.SourceKind } + ".png")" alt="@_it.SourceKind" style="height:16px;opacity:.7;" onerror="this.style.display='none'" />
                    </div>
                }
            </div>
        }
    </div>
    <div id="media-sentinel" style="height:1px;"></div>
    @if (totalCount > items.Count)
    {
        <div style="margin-top:1rem;text-align:center;">
            <button class="ghost" @onclick="() => LoadMore()">Load more</button>
        </div>
    }
}
@code {
    private bool loading;
    private DotNetObjectReference<Media>? dotNetRef;
    private string activeTab = "Movies";
    private readonly List<string> tabs = new() { "Movies", "TV Shows", "Music", "Music Videos", "News" };
    private List<MediaItem> items = new();
    private int totalCount;
    private int offset;
    private const int PageSize = 50;
    private string filterLetter = "";

    private string TabToKind(string tab) => tab switch
    {
        "Movies" => "movie",
        "TV Shows" => "series",
        "Music" => "album",
        "Music Videos" => "musicvideo",
        "News" => "news",
        _ => "movie"
    };

    protected override async Task OnInitializedAsync() => await LoadTab();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
        }
        try { await JS.InvokeVoidAsync("setupMediaInfiniteScroll", dotNetRef); } catch { }
    }

    [JSInvokable("TriggerLoadMore")]
    public async Task TriggerLoadMore()
    {
        if (items.Count < totalCount && !loading)
        {
            await LoadMore();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        offset = 0;
        await LoadTab();
    }

    private async Task LoadTab()
    {
        loading = true;
        items = new();
        offset = 0;
        try
        {
            var kind = TabToKind(activeTab);
            var res = await Http.GetFromJsonAsync<CatalogResponse>($"api/media/catalog?kind={kind}&limit={PageSize}&offset=0", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null)
            {
                items = res.Items ?? new();
                totalCount = res.Count;
                offset = items.Count;
            }
        }
        catch { items = new(); }
        loading = false;
    }

    private void OpenItem(string matchKey) => Nav.NavigateTo($"/media/item/{Uri.EscapeDataString(matchKey)}", forceLoad: true);

    private void SetFilter(string letter)
    {
        filterLetter = letter;
    }

    private List<MediaItem> FilteredItems => string.IsNullOrEmpty(filterLetter)
        ? items
        : items.Where(i => !string.IsNullOrEmpty(i.Title) && i.Title.StartsWith(filterLetter, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task LoadMore()
    {
        try
        {
            var kind = TabToKind(activeTab);
            var res = await Http.GetFromJsonAsync<CatalogResponse>($"api/media/catalog?kind={kind}&limit={PageSize}&offset={offset}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null && res.Items is not null)
            {
                items.AddRange(res.Items);
                offset = items.Count;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception e) { Console.WriteLine("LoadMore error: " + e.Message); }
    }

    public class MediaItem
    {
        public string MatchKey { get; set; } = "";
        public string Kind { get; set; } = "";
        public string Title { get; set; } = "";
        public int? Year { get; set; }
        public List<string> Genres { get; set; } = new();
        public string? OfficialRating { get; set; }
        public string? PosterUrl { get; set; }
        public long? RuntimeMs { get; set; }
        public string? WebUrl { get; set; }
        public string? SourceKind { get; set; }
        public string? Overview { get; set; }
    }
    public class MediaDetail
    {
        public MediaItem? Item { get; set; }
        public List<CreditDto> Credits { get; set; } = new();
    }
    public class CreditDto
    {
        public Guid Id { get; set; }
        public Guid PersonId { get; set; }
        public string MediaMatchKey { get; set; } = "";
        public string Role { get; set; } = "";
        public string? Character { get; set; }
        public string? ImagePath { get; set; }
    }
    public class CatalogResponse
    {
        public List<MediaItem> Items { get; set; } = new();
        public int Count { get; set; }
        public int Offset { get; set; }
        public int Limit { get; set; }
    }
}
