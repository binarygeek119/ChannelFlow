@using Microsoft.JSInterop
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@page "/people"
@rendermode RenderMode.InteractiveServer
@page "/people/{name}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (selectedPerson is null)
{
    <div class="panel">
        <div class="panel-head">
            <span class="count">@peopleTotal</span>
        </div>
        <p class="hint">
            Everyone synced from your media library's cast lists, alphabetical by name. Their
            pictures come with the library scan's image pass.
        </p>
        <div class="inner-tabs" style="margin-bottom:1rem;">
            @foreach (var r in roles)
            {
                <button class="inner-tab @(activeRole == r ? "active" : "")" @onclick="() => SwitchRole(r)">@r</button>
            }
        </div>
        <div class="people-toolbar" style="margin-bottom:1rem;display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;">
            <input type="search" @bind="filter" @bind:event="oninput" @bind:after="OnFilterChanged" placeholder="Filter people…" style="width:300px;" />
            <label style="display:flex;align-items:center;gap:.3rem;">
                Sort by
                <select @bind="sortMode" @bind:after="StateHasChanged">
                    <option value="first">First name</option>
                    <option value="last">Last name</option>
                </select>
            </label>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.25rem;margin-bottom:1rem;">
            <button class="ghost" style="min-width:32px;padding:.2rem .4rem;@(filterLetter == "" ? "background:var(--accent);color:#fff;" : "")" @onclick='() => SetLetter("")'>All</button>
            @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray())
            {
                <button class="ghost" style="min-width:32px;padding:.2rem .4rem;@(filterLetter == letter.ToString() ? "background:var(--accent);color:#fff;" : "")" @onclick="() => SetLetter(letter.ToString())">@letter</button>
            }
        </div>
        @if (loading) { <p>Loading...</p> }
        else if (people.Count == 0) { <p class="empty">No people synced yet — run a library scan and the cast appears here.</p> }
        else
        {
            <div class="people-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:1rem;">
                @foreach (var p in FilteredPeople)
                {
                    <div class="people-card" style="cursor:pointer;text-align:center;" @onclick="() => OpenPerson(p.Name)">
                        <div class="people-avatar" style="width:80px;height:80px;margin:0 auto;border-radius:50%;background:var(--card-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;">
                            @if (!string.IsNullOrEmpty(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@p.Name" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/person-placeholder.svg'" />
                            }
                            else
                            {
                                <img src="/images/person-placeholder.svg" alt="@p.Name" style="width:100%;height:100%;object-fit:cover;" />
                            }
                        </div>
                        <div class="people-name" title="@p.Name" style="margin-top:.5rem;font-size:.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@p.Name</div>
                    </div>
                }
            </div>
            <div id="people-sentinel" style="height:1px;"></div>
            @if (people.Count < peopleTotal)
            {
                <div style="margin-top:1rem;text-align:center;">
                    <button class="ghost" @onclick="LoadMore">Load more (@people.Count/@peopleTotal)</button>
                </div>
            }
        }
    </div>
}
else
{
    <div class="people-person">
        <button class="media-back" @onclick="BackToList">← People</button>
        <div class="people-person-head" style="display:flex;gap:1rem;align-items:center;margin:1rem 0;">
            <div class="people-person-photo-frame" style="width:120px;height:120px;border-radius:50%;background:var(--card-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;">
                @if (!string.IsNullOrEmpty(selectedPerson.ImagePath))
                {
                    <img src="@selectedPerson.ImagePath" alt="@selectedPerson.Name" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='/images/person-placeholder.svg'" />
                }
                else
                {
                    <img src="/images/person-placeholder.svg" alt="@selectedPerson.Name" style="width:100%;height:100%;object-fit:cover;" />
                }
            </div>
            <div class="people-person-meta">
                <h1>@selectedPerson.Name</h1>
                <div class="people-person-sub">@(selectedPerson.Credits?.Count ?? 0) title(s) in your catalog</div>
            </div>
        </div>
        @if (selectedPerson.Credits is not null && selectedPerson.Credits.Count > 0)
        {
            <div class="people-items" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1rem;">
                @foreach (var c in selectedPerson.Credits)
                {
                    <a href="/media/item/@Uri.EscapeDataString(c.MediaMatchKey)" class="people-item" style="text-align:center;text-decoration:none;color:inherit;display:block;">
                        <div class="people-item-poster" style="height:120px;background:var(--card-bg);border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:.5rem;overflow:hidden;">
                            @if (!string.IsNullOrEmpty(c.PosterUrl))
                            {
                                <img src="@c.PosterUrl" alt="@c.Title" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <span style="font-size:.7rem;color:var(--muted);">@c.Role</span>
                            }
                        </div>
                        <div class="people-item-title" style="font-size:.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(string.IsNullOrEmpty(c.Title) ? c.MediaMatchKey : c.Title)</div>
                        @if (c.Year.HasValue) { <div class="people-item-sub" style="font-size:.75rem;color:var(--muted);">@c.Year</div> }
                        @if (!string.IsNullOrEmpty(c.Character)) { <div class="people-item-sub" style="font-size:.75rem;color:var(--muted);">@c.Character</div> }
                        @if (!string.IsNullOrEmpty(c.Role)) { <div class="people-item-sub" style="font-size:.7rem;color:var(--muted);">@c.Role</div> }
                    </a>
                }
            </div>
        }
        else
        {
            <p class="hint">No catalog titles for this person yet.</p>
        }
    </div>
}

@code {
    [Parameter] public string? name { get; set; }
    private List<PersonDto> people = new();
    private PersonDetail? selectedPerson;
    private string filter = "";
    private string filterLetter = "";
    private string activeRole = "All";
    private string sortMode = "first";
    private readonly List<string> roles = new() { "All", "Actor", "Director", "Writer", "Producer", "Artist" };
    private bool loading;
    private int peopleTotal;
    private int peopleOffset;
    private System.Threading.Timer? filterTimer;

    private DotNetObjectReference<People>? dotNetRef;

    protected override async Task OnInitializedAsync() => await Load(true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupPeopleInfiniteScroll", dotNetRef);
        }
    }

    [JSInvokable("TriggerLoadMore")]
    public async Task TriggerLoadMore()
    {
        if (people.Count < peopleTotal && !loading)
        {
            await Load(false);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private async Task Load(bool reset = true)
    {
        if (!string.IsNullOrEmpty(name))
        {
            await LoadPerson(name);
            return;
        }
        selectedPerson = null;
        if (reset) { people = new(); peopleOffset = 0; peopleTotal = 0; }
        loading = true;
        try
        {
            var url = $"api/people?limit=100&offset={peopleOffset}";
            if (!string.IsNullOrEmpty(filter)) url += $"&search={Uri.EscapeDataString(filter)}";
            if (activeRole != "All") url += $"&role={Uri.EscapeDataString(activeRole)}";
            var res = await Http.GetFromJsonAsync<PeopleResponse>(url, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null)
            {
                people.AddRange(res.Items ?? new());
                peopleTotal = res.Total;
                peopleOffset = people.Count;
            }
        }
        catch { if (reset) people = new(); }
        loading = false;
    }

    private async Task LoadMore()
    {
        if (people.Count >= peopleTotal) return;
        await Load(false);
    }

    private async Task LoadPerson(string personName)
    {
        try
        {
            var res = await Http.GetFromJsonAsync<PersonDetail>($"api/people/lookup?name={Uri.EscapeDataString(personName)}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            selectedPerson = res;
        }
        catch { selectedPerson = null; }
    }

    private void OpenPerson(string personName)
    {
        Nav.NavigateTo($"/people/{Uri.EscapeDataString(personName)}");
    }

    private void BackToList()
    {
        Nav.NavigateTo("/people");
        selectedPerson = null;
        _ = Load();
    }

    private void OnFilterChanged()
    {
        _ = Load(true);
    }

    private void SetLetter(string letter) { filterLetter = letter; }

    private List<PersonDto> FilteredPeople
    {
        get
        {
            var filtered = string.IsNullOrEmpty(filterLetter)
                ? people
                : people.Where(p => !string.IsNullOrEmpty(p.Name) && p.Name.StartsWith(filterLetter, StringComparison.OrdinalIgnoreCase)).ToList();
            if (sortMode == "last")
                return filtered.OrderBy(p => LastName(p.Name)).ThenBy(p => p.Name).ToList();
            return filtered.OrderBy(p => p.Name).ToList();
        }
    }

    private static string LastName(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[^1] : parts.Length > 0 ? parts[0] : "";
    }

    private async Task SwitchRole(string role)
    {
        activeRole = role;
        await Load(true);
    }

    private static string Initials(string name)
    {
        return string.Join("", name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));
    }

    public class PeopleResponse { public List<PersonDto> Items { get; set; } = new(); public int Total { get; set; } public int Offset { get; set; } public int Limit { get; set; } }
    public class PersonDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? ImagePath { get; set; }
    }
    public class PersonDetail
    {
        public PersonDto? Person { get; set; }
        public List<CreditDto> Credits { get; set; } = new();
        public string Name => Person?.Name ?? "";
        public string? ImagePath => Person?.ImagePath;
    }
    public class CreditDto
    {
        public Guid Id { get; set; }
        public Guid PersonId { get; set; }
        public string MediaMatchKey { get; set; } = "";
        public string Role { get; set; } = "";
        public string? Character { get; set; }
        public string? ImagePath { get; set; }
        public string? Title { get; set; }
        public string? PosterUrl { get; set; }
        public int? Year { get; set; }
    }
}
