@page "/tasks"
@inject HttpClient Http
<h2>Tasks</h2>
<p class="hint">Scheduled jobs like library scans and cache cleanup.</p>

<div class="panel" style="margin-bottom:1rem;">
    <div class="panel-head"><h2>Jellyfin Library Scan</h2></div>
    <p class="hint">
        Syncs the Jellyfin libraries you selected on the Library page. It runs daily on the
        server's clock, or whenever you hit Run now.
    </p>
    <div class="ms-form-actions">
        <button type="button" class="primary" @onclick="RunJellyfinSync" disabled="@syncing">@(syncing ? "Syncing..." : "Run now")</button>
    </div>
    @if (!string.IsNullOrEmpty(jellyfinMsg)) { <p class="hint">@jellyfinMsg</p> }
</div>

<div class="panel" style="margin-bottom:1rem;">
    <div class="panel-head"><h2>Past Tense News Thumbnails</h2></div>
    <p class="hint">Extract thumbnails from news videos (10-30% into video, skipping black/white frames). Runs daily or on demand.</p>
    <div class="ms-form-actions">
        <button type="button" class="primary" @onclick="RunPastTenseThumbs" disabled="@thumbsSyncing">@(thumbsSyncing ? "Extracting..." : "Run now")</button>
    </div>
    @if (!string.IsNullOrEmpty(thumbsMsg)) { <p class="hint">@thumbsMsg</p> }
</div>

<div class="panel" style="margin-bottom:1rem;">
    <div class="panel-head"><h2>Scheduler</h2></div>
    <p class="hint">Build the channel guide and lineups.</p>
    <div class="actions">
        <button class="primary" @onclick="BuildSchedule">Build Schedule</button>
        <button class="ghost" @onclick="CancelBuild">Cancel</button>
    </div>
    @if (schedStatus is not null) { <p class="hint">Status: @schedStatus.Status (@schedStatus.Current/@schedStatus.Total)</p> }
</div>

<div class="panel" style="margin-bottom:1rem;">
    <div class="panel-head"><h2>Maintenance</h2></div>
    <p class="hint">One-off jobs you run yourself — these are not on a timer.</p>
    <div class="actions">
        <button type="button" class="ghost" @onclick="RebuildPlayouts">Rebuild All Playouts</button>
    </div>
    @if (!string.IsNullOrEmpty(maintMsg)) { <p class="hint">@maintMsg</p> }
</div>

<div class="panel">
    <div class="panel-head"><h2>Running Tasks</h2></div>
    @if (tasks.Count == 0) { <p class="empty">No tasks running.</p> }
    else
    {
        @foreach (var t in tasks)
        {
            <div style="margin-bottom:.5rem;">
                <strong>@t.Title</strong> — @t.Label (@t.Current/@t.Total)
                <div style="background:#333;border-radius:4px;height:8px;margin-top:.25rem;">
                    <div style="background:var(--accent);height:8px;border-radius:4px;width:@(t.Total > 0 ? (t.Current*100/t.Total) : 0)%"></div>
                </div>
                @if (!string.IsNullOrEmpty(t.Detail)) { <p class="hint" style="margin:.25rem 0 0;">@t.Detail</p> }
            </div>
        }
    }
    <button class="ghost" @onclick="RefreshTasks">Refresh</button>
</div>
@code {
    private List<TaskDto> tasks = new();
    private SchedStatus? schedStatus;
    private string? maintMsg, jellyfinMsg, thumbsMsg;
    private bool syncing, thumbsSyncing;

    protected override async Task OnInitializedAsync() => await RefreshTasks();

    private async Task RefreshTasks()
    {
        try
        {
            tasks = await Http.GetFromJsonAsync<List<TaskDto>>("api/tasks/running", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { tasks = new(); }
    }

    private async Task RunJellyfinSync()
    {
        syncing = true;
        jellyfinMsg = "Starting sync...";
        try
        {
            // Get all connections
            var conns = await Http.GetFromJsonAsync<List<ConnDto>>("api/connections", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            foreach (var conn in conns.Where(c => c.Kind == "jellyfin"))
            {
                // Parse config
                Dictionary<string, string> config = new();
                try { config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(conn.ConfigJson) ?? new(); } catch { }
                var url = config.TryGetValue("url", out var u) ? u : "";
                var apiKey = config.TryGetValue("apiKey", out var k) ? k : "";
                // Get saved libraries
                var savedLibs = new List<string>();
                if (config.TryGetValue("selectedLibraries", out var sl))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(sl);
                        if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                            savedLibs = doc.RootElement.EnumerateArray().Select(e => e.GetString() ?? "").ToList();
                        else if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            using var inner = System.Text.Json.JsonDocument.Parse(doc.RootElement.GetString() ?? "[]");
                            if (inner.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                                savedLibs = inner.RootElement.EnumerateArray().Select(e => e.GetString() ?? "").ToList();
                        }
                    }
                    catch { }
                }
                if (savedLibs.Count == 0)
                {
                    // Fall back to fetching libraries
                    try
                    {
                        var libs = await Http.GetFromJsonAsync<List<LibDto>>($"api/media/libraries/{conn.Id}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (libs is not null) savedLibs = libs.Select(l => l.Id).ToList();
                    }
                    catch { }
                }
                if (savedLibs.Count == 0) { jellyfinMsg = $"No libraries configured for {conn.Name}."; continue; }
                var mediaTypes = new Dictionary<string, string>();
                foreach (var lib in savedLibs) mediaTypes[lib] = "movie";
                var res = await Http.PostAsJsonAsync("api/media/sync-libraries", new { ConnectionId = conn.Id, LibraryIds = savedLibs, MediaTypes = mediaTypes });
                var body = await res.Content.ReadAsStringAsync();
                jellyfinMsg = $"{conn.Name}: {body}";
            }
            if (conns.Count(c => c.Kind == "jellyfin") == 0) jellyfinMsg = "No Jellyfin connections configured.";
        }
        catch (Exception e) { jellyfinMsg = "Error: " + e.Message; }
        syncing = false;
        await RefreshTasks();
    }

    private async Task RunPastTenseThumbs()
    {
        thumbsSyncing = true;
        thumbsMsg = "Starting...";
        try
        {
            var conns = await Http.GetFromJsonAsync<List<ConnDto>>("api/connections", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            foreach (var conn in conns.Where(c => c.Kind == "pasttense"))
            {
                var res = await Http.PostAsJsonAsync("api/pasttense/thumbnails", new { ConnectionId = conn.Id });
                var body = await res.Content.ReadAsStringAsync();
                thumbsMsg = $"{conn.Name}: {body}";
            }
            if (conns.Count(c => c.Kind == "pasttense") == 0) thumbsMsg = "No Past Tense connections configured.";
        }
        catch (Exception e) { thumbsMsg = "Error: " + e.Message; }
        thumbsSyncing = false;
        await RefreshTasks();
    }

    private async Task BuildSchedule()
    {
        await Http.PostAsync("api/plugins/com.channelflow.scheduler/build", null);
        await PollScheduler();
    }

    private async Task CancelBuild()
    {
        await Http.PostAsync("api/plugins/com.channelflow.scheduler/cancel", null);
        await PollScheduler();
    }

    private async Task PollScheduler()
    {
        try { schedStatus = await Http.GetFromJsonAsync<SchedStatus>("api/plugins/com.channelflow.scheduler/status", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }); }
        catch { }
    }

    private async Task RebuildPlayouts()
    {
        var res = await Http.PostAsync("api/playout/generate-all", null);
        maintMsg = await res.Content.ReadAsStringAsync();
    }

    public class TaskDto { public string Key { get; set; } = ""; public string Title { get; set; } = ""; public string? Label { get; set; } public long Current { get; set; } public long Total { get; set; } public string Status { get; set; } = "running"; public string? Detail { get; set; } }
    public class SchedStatus { public string Status { get; set; } = ""; public bool Running { get; set; } public int Current { get; set; } public int Total { get; set; } }
    public class ConnDto { public int Id { get; set; } public string Name { get; set; } = ""; public string Kind { get; set; } = ""; public string ConfigJson { get; set; } = ""; }
    public class LibDto { public string Id { get; set; } = ""; public string Name { get; set; } = ""; }
}
