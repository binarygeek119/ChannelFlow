@page "/media"
@inject HttpClient Http
<h2>Media</h2>

<div class="panel" style="margin-bottom:1rem;">
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
        <input @bind="url" placeholder="Jellyfin URL" style="width:300px;" />
        <input @bind="apiKey" placeholder="API Key" style="width:200px;" />
        <input @bind="libraryId" placeholder="Library Id" style="width:150px;" />
        <button class="primary" @onclick="Sync" disabled="@syncing">@(syncing ? "Syncing..." : "Sync")</button>
    </div>
    @if (!string.IsNullOrEmpty(syncResult)) { <p class="field-note">@syncResult</p> }
</div>

<div class="inner-tabs" style="margin-bottom:1rem;">
    @foreach (var tab in tabs)
    {
        <button class="inner-tab @(activeTab == tab ? "active" : "")" @onclick="() => SwitchTab(tab)">@tab</button>
    }
</div>

@if (loading) { <p>Loading...</p> }
else if (items.Count == 0) { <p class="empty">No items in this category.</p> }
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1rem;">
        @foreach (var it in items)
        {
            <div class="card jf-card" style="cursor:pointer;" title="@it.Title">
                <div style="aspect-ratio:2/3;background:var(--card-bg);border-radius:var(--radius);overflow:hidden;margin-bottom:.5rem;">
                    @if (!string.IsNullOrEmpty(it.PosterUrl))
                    {
                        <img src="@it.PosterUrl" alt="@it.Title" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);">No poster</div>
                    }
                </div>
                <div class="cardText cardText-first" style="font-size:.9rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@it.Title</div>
                <div class="cardText cardText-secondary" style="font-size:.75rem;color:var(--muted);">@(it.Year?.ToString() ?? it.Kind)</div>
            </div>
        }
    </div>
    @if (totalCount > items.Count)
    {
        <div style="margin-top:1rem;text-align:center;">
            <button class="ghost" @onclick="LoadMore">Load more</button>
        </div>
    }
}
@code {
    private string url = "http://localhost:8096";
    private string apiKey = "";
    private string libraryId = "";
    private bool syncing, loading;
    private string? syncResult;
    private string activeTab = "Movies";
    private readonly List<string> tabs = new() { "Movies", "TV Shows", "Music", "Music Videos", "News" };
    private List<MediaItem> items = new();
    private int totalCount;
    private int offset;
    private const int PageSize = 50;

    private string TabToKind(string tab) => tab switch
    {
        "Movies" => "movie",
        "TV Shows" => "series",
        "Music" => "album",
        "Music Videos" => "musicvideo",
        "News" => "news",
        _ => "movie"
    };

    protected override async Task OnInitializedAsync() => await LoadTab();

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        offset = 0;
        await LoadTab();
    }

    private async Task LoadTab()
    {
        loading = true;
        items = new();
        offset = 0;
        try
        {
            var kind = TabToKind(activeTab);
            var res = await Http.GetFromJsonAsync<CatalogResponse>($"api/media/catalog?kind={kind}&limit={PageSize}&offset=0", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null)
            {
                items = res.Items ?? new();
                totalCount = res.Count;
                offset = items.Count;
            }
        }
        catch { items = new(); }
        loading = false;
    }

    private async Task LoadMore()
    {
        try
        {
            var kind = TabToKind(activeTab);
            var res = await Http.GetFromJsonAsync<CatalogResponse>($"api/media/catalog?kind={kind}&limit={PageSize}&offset={offset}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null && res.Items is not null)
            {
                items.AddRange(res.Items);
                offset = items.Count;
            }
        }
        catch { }
    }

    private async Task Sync()
    {
        syncing = true;
        syncResult = null;
        try
        {
            var req = new { Url = url, ApiKey = apiKey, LibraryId = libraryId };
            var res = await Http.PostAsJsonAsync("api/media/sync-jellyfin", req);
            syncResult = await res.Content.ReadAsStringAsync();
            await LoadTab();
        }
        catch (Exception e) { syncResult = "Error: " + e.Message; }
        syncing = false;
    }

    public class MediaItem
    {
        public string MatchKey { get; set; } = "";
        public string Kind { get; set; } = "";
        public string Title { get; set; } = "";
        public int? Year { get; set; }
        public List<string> Genres { get; set; } = new();
        public string? OfficialRating { get; set; }
        public string? PosterUrl { get; set; }
    }
    public class CatalogResponse
    {
        public List<MediaItem> Items { get; set; } = new();
        public int Count { get; set; }
        public int Offset { get; set; }
        public int Limit { get; set; }
    }
}
