@page "/channels"
@inject HttpClient Http
<div style="display:grid;grid-template-columns:2fr 1fr;gap:1rem;align-items:start;">
    <div class="panel">
        <div class="panel-head">
            <h2>Channels</h2>
            <span class="count">@channelCount</span>
        </div>
        @if (channels is null) { <p class="empty">Loading...</p> }
        else if (channels.Count == 0) { <p class="empty">No channels yet — add one on the right.</p> }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th class="num">#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="state">State</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in channels)
                {
                    <tr>
                        <td class="num">@c.Number</td>
                        <td class="channel-name">@c.Name</td>
                        <td class="channel-desc">@c.Description</td>
                        <td class="state"><span class="pill @(c.Enabled ? "on" : "off")">@(c.Enabled ? "ON" : "OFF")</span></td>
                        <td class="actions">
                            <a href="/channels/@c.Id" class="link">Edit</a>
                            <button class="link danger" @onclick="() => Delete(c.Id)">Delete</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Add channel</h2>
        </div>
        <form class="ms-form" @onsubmit="Create" @onsubmit:preventDefault>
            <label>
                <span>Number</span>
                <input type="number" min="1" step="any" @bind="newNumber" required>
            </label>
            <label>
                <span>Name</span>
                <input type="text" maxlength="80" @bind="newName" required placeholder="The Holiday Channel">
            </label>
            <label>
                <span>Description</span>
                <input type="text" maxlength="200" @bind="newDesc" placeholder="Shown in the program guide">
            </label>
            <label>
                <span>AI scheduling prompt</span>
                <textarea rows="3" maxlength="2000" @bind="newPrompt" placeholder="How the AI should schedule this channel..."></textarea>
            </label>
            <label class="check">
                <input type="checkbox" @bind="newEnabled">
                <span>Enabled</span>
            </label>
            <div class="actions">
                <button type="submit" class="primary">Add channel</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(error)) { <p class="error">@error</p> }
    </div>
</div>
@code {
    private List<ChannelDto>? channels;
    private double newNumber = 1;
    private string newName = "";
    private string newDesc = "";
    private string newPrompt = "";
    private bool newEnabled = true;
    private string? error;
    private int channelCount => channels?.Count ?? 0;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { channels = await Http.GetFromJsonAsync<List<ChannelDto>>("api/channels", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }); }
        catch { channels = new(); }
    }

    private async Task Create()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(newName)) { error = "Name is required"; return; }
        try
        {
            await Http.PostAsJsonAsync("api/channels", new { Number = newNumber, Name = newName, Description = newDesc, AiPrompt = newPrompt, Enabled = newEnabled });
            newName = ""; newDesc = ""; newPrompt = ""; newEnabled = true;
            await Load();
        }
        catch (Exception e) { error = e.Message; }
    }

    private async Task Delete(Guid id)
    {
        await Http.DeleteAsync($"api/channels/{id}");
        await Load();
    }

    public record ChannelDto(Guid Id, double Number, string Name, string Description, string AiPrompt, bool Enabled);
}
