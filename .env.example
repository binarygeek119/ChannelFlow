# Copy to `.env` next to docker-compose.yml to override defaults.
#
# The container's time zone. The entrypoint applies it to /etc/localtime and
# /etc/timezone on every start, so the server and the processes it runs use it.
# Any IANA name (see /usr/share/zoneinfo) works, e.g. America/New_York, UTC.
TZ=America/Chicago

# Where your media lives on the host, mounted at /media in the container.
MEDIA_ROOT=/mnt/user/media

# Postgres connection string. Uncomment to point at an existing database; leave
# it out to use the bundled `postgres` service from docker-compose.yml.
# DATABASE_URL=postgres://channelflow:channelflow@postgres:5432/channelflow
