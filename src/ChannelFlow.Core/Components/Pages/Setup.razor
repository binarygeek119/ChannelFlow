@using Microsoft.AspNetCore.Components.Web
@page "/setup"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
<h2>Setup Wizard</h2>
<p>Configure your database provider. Set these as environment variables in Docker or in appsettings.json, then restart.</p>

<!-- Database Status Popup -->
@if (showStatusPopup)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;display:flex;align-items:center;justify-content:center;" @onclick="() => showStatusPopup = false">
        <div style="background:var(--card-bg, #1b1b1b);color:var(--text, #eee);border:1px solid var(--border, #2a2a2a);padding:1.5rem;border-radius:8px;max-width:500px;width:90%;" @onclick:stopPropagation="true">
            <h3 style="margin-top:0;">Database Status</h3>
            <table style="width:100%;border-collapse:collapse;">
                <tr><td style="padding:.4rem;font-weight:bold;color:var(--text,#eee);">Provider</td><td style="padding:.4rem;">@currentProvider</td></tr>
                <tr><td style="padding:.4rem;font-weight:bold;color:var(--text,#eee);">Connection</td><td style="padding:.4rem;">@(string.IsNullOrEmpty(currentConnStr) ? "Not configured" : MaskPassword(currentConnStr))</td></tr>
                <tr><td style="padding:.4rem;font-weight:bold;color:var(--text,#eee);">Status</td><td style="padding:.4rem;color:@(dbConnected ? "green" : "red");">@(dbConnected ? "Connected" : "Not connected")</td></tr>
                <tr><td style="padding:.4rem;font-weight:bold;color:var(--text,#eee);">Tables</td><td style="padding:.4rem;">@tableCount</td></tr>
            </table>
            <div style="margin-top:1rem;text-align:right;">
                <button @onclick="() => showStatusPopup = false">Close</button>
            </div>
        </div>
    </div>
}

<div style="margin-bottom:1rem;">
    <button class="primary" @onclick="ShowStatus">Show Database Status</button>
</div>

<div style="display:grid;gap:.5rem;max-width:600px;">
    <label>Provider
        <select @bind="provider" @bind:after="OnProviderChanged">
            <option value="sqlite">SQLite</option>
            <option value="postgres">PostgreSQL</option>
            <option value="mariadb">MariaDB/MySQL</option>
        </select>
    </label>
    @if (provider == "sqlite")
    {
        <label>File path <input @bind="sqlitePath" style="width:100%;" /></label>
    }
    else
    {
        <label>Host <input @bind="host" style="width:100%;" /></label>
        <label>Port <input @bind="port" style="width:100%;" /></label>
        <label>Database <input @bind="database" style="width:100%;" /></label>
        <label>Username <input @bind="username" style="width:100%;" /></label>
        <label>Password <input @bind="password" type="password" style="width:100%;" /></label>
    }
    <div style="display:flex;gap:.5rem;">
        <button @onclick="Test">Test Connection</button>
        <button @onclick="Configure">Save & Configure</button>
    </div>
    @if (testResult is not null) { <p style="color:@(testResult.StartsWith("OK")?"green":"red")">@testResult</p> }
    @if (configureResult is not null) { <p style="color:green;">@configureResult</p> }
</div>
<h3>Example configurations</h3>
<pre>SQLite:    Data Source=/config/channelflow.db
Postgres:  Host=localhost;Port=5432;Database=channelflow;Username=channelflow;Password=channelflow
MariaDB:   Server=localhost;Port=3306;Database=channelflow;Uid=channelflow;Pwd=channelflow</pre>
<h3>Docker environment variables</h3>
<pre>DATABASE_PROVIDER=postgres
CONNECTION_STRING=Host=postgres;Port=5432;Database=channelflow;Username=channelflow;Password=channelflow</pre>
@code {
    private string provider = "sqlite";
    private string sqlitePath = "/config/channelflow.db";
    private string host = "localhost";
    private string port = "5432";
    private string database = "channelflow";
    private string username = "channelflow";
    private string password = "channelflow";
    private string? testResult;
    private string? configureResult;

    // Status popup state
    private bool showStatusPopup;
    private string currentProvider = "unknown";
    private string currentConnStr = "";
    private bool dbConnected;
    private int tableCount;

    private string ConnectionString => provider == "sqlite"
        ? $"Data Source={sqlitePath}"
        : provider == "mariadb"
            ? $"Server={host};Port={port};Database={database};Uid={username};Pwd={password}"
            : $"Host={host};Port={port};Database={database};Username={username};Password={password}";

    private async Task ShowStatus()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<DbStatus>("api/setup/db-status", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (res is not null)
            {
                currentProvider = res.Provider;
                currentConnStr = res.ConnectionString;
                dbConnected = res.Connected;
                tableCount = res.TableCount;
            }
        }
        catch (Exception e)
        {
            currentProvider = "error";
            currentConnStr = e.Message;
            dbConnected = false;
            tableCount = 0;
        }
        showStatusPopup = true;
    }

    private string MaskPassword(string connStr)
    {
        // Mask password in connection string
        var idx = connStr.IndexOf("Password=", StringComparison.OrdinalIgnoreCase);
        if (idx < 0) idx = connStr.IndexOf("Pwd=", StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return connStr;
        var end = connStr.IndexOf(';', idx);
        if (end < 0) end = connStr.Length;
        return connStr[..idx] + "Password=****" + connStr[end..];
    }

    private void OnProviderChanged() { StateHasChanged(); }
    private async Task Test()
    {
        try
        {
            var res = await Http.PostAsJsonAsync("api/setup/test-db", new { Provider = provider, ConnectionString = ConnectionString });
            testResult = await res.Content.ReadAsStringAsync();
            if (res.IsSuccessStatusCode) testResult = "OK: " + testResult;
        }
        catch (Exception e) { testResult = "Error: " + e.Message; }
    }

    private async Task Configure()
    {
        try
        {
            var res = await Http.PostAsJsonAsync("api/setup/configure", new { Provider = provider, ConnectionString = ConnectionString });
            configureResult = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) configureResult = "Error: " + configureResult;
        }
        catch (Exception e) { configureResult = "Error: " + e.Message; }
    }

    public class DbStatus
    {
        public string Provider { get; set; } = "";
        public string ConnectionString { get; set; } = "";
        public bool Connected { get; set; }
        public int TableCount { get; set; }
    }
}
