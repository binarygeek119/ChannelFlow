@using ChannelFlow.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@page "/library"
@rendermode RenderMode.InteractiveServer
@page "/library/{connId}"
@inject HttpClient Http
@inject NavigationManager Nav
<h2>Library</h2>
<p class="hint">Media connections and synced libraries. Manage connections, sync libraries, and browse the catalog.</p>

<div class="inner-tabs" style="margin-bottom:1rem;">
    <button class="inner-tab @(activeTab == "connections" ? "active" : "")" @onclick='() => activeTab = "connections"'>Connections</button>
    @if (connections is not null)
    {
        @foreach (var c in connections)
        {
            <button class="inner-tab @(activeTab == $"conn-{c.Id}" ? "active" : "")" @onclick="() => SelectConnection(c)">@(!string.IsNullOrEmpty(c.Name) ? c.Name : $"Connection {c.Id}")</button>
        }
    }
</div>

@if (activeTab == "connections")
{
    <div class="panel" style="margin-bottom:1rem;">
        <div class="panel-head">
            <h2>Add Connection</h2>
        </div>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;">
            <input @bind="newName" placeholder="Name" style="width:150px;" />
            <select @bind="newKind">
                <option value="jellyfin">Jellyfin</option>
            </select>
            <input @bind="newUrl" placeholder="Server URL" style="width:250px;" />
            <input @bind="newApiKey" placeholder="API Key" style="width:180px;" />
            <button class="primary" @onclick="CreateConnection" disabled="@creating">@(creating ? "Adding..." : "Add Connection")</button>
        </div>
        @if (!string.IsNullOrEmpty(connMsg)) { <p class="field-note">@connMsg</p> }
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Connections</h2>
            <span class="count">@(connections?.Count ?? 0)</span>
        </div>
        @if (connections is null) { <p>Loading...</p> }
        else if (connections.Count == 0) { <p class="empty">No connections yet.</p> }
        else
        {
            <table>
                <thead><tr><th>ID</th><th>Name</th><th>Kind</th><th>Config</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in connections)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@(!string.IsNullOrEmpty(c.Name) ? c.Name : $"Connection {c.Id}")</td>
                        <td>@c.Kind</td>
                        <td><code>@c.ConfigJson</code></td>
                        <td><button class="link danger" @onclick="() => AskDelete(c.Id)">Delete</button></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}
else if (activeTab.StartsWith("conn-"))
{
    @if (selectedConn is not null)
    {
        <div class="panel" style="margin-bottom:1rem;">
            <div class="panel-head">
                <h2>@(!string.IsNullOrEmpty(selectedConn.Name) ? selectedConn.Name : $"Connection {selectedConn.Id}")</h2>
                <span class="count">@libraries.Count libraries</span>
            </div>
            <p class="hint">Kind: @selectedConn.Kind</p>

            @if (loadingLibs) { <p>Loading libraries...</p> }
            else if (libraries.Count == 0) { <p class="empty">No libraries found. Check the connection.</p> }
            else
            {
                <table style="width:100%;border-collapse:collapse;">
                    <thead><tr><th></th><th>Name</th><th>ID</th><th>Media Type</th></tr></thead>
                    <tbody>
                    @foreach (var lib in libraries)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="lib.Selected" /></td>
                            <td>@lib.Name</td>
                            <td><code>@lib.Id</code></td>
                            <td>
                                <select @bind="lib.MediaTypeStr">
                                    <option value="movie">Movie</option>
                                    <option value="series">TV Show</option>
                                    <option value="album">Music (Album)</option>
                                    <option value="artist">Music (Artist)</option>
                                    <option value="musicvideo">Music Video</option>
                                    <option value="news">News</option>
                                </select>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div style="margin-top:1rem;display:flex;gap:.5rem;">
                    <button class="ghost" @onclick="TestConn" disabled="@testing">@(testing ? "Testing..." : "Test Connection")</button>
                    <button class="ghost" @onclick="SaveSelected" disabled="@saving">@(saving ? "Saving..." : "Save Selected")</button>
                <button class="primary" @onclick="SyncSelected" disabled="@syncing">@(syncing ? "Syncing..." : "Sync Selected")</button>
                </div>
                @if (!string.IsNullOrEmpty(testResult)) { <p class="field-note" style="color:@(testResult.StartsWith("OK")?"var(--ok)":"var(--danger)")">@testResult</p> }
                @if (!string.IsNullOrEmpty(syncResult)) { <p class="field-note">@syncResult</p> }

    @if (showSavePopup)
    {
        <div class="task-popup-wrap" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:120;">
            <div class="task-popup status-done fading">
                <div class="task-popup-head">Saved</div>
                <div class="task-popup-status">@(savePopupMsg ?? "Selected libraries saved.")</div>
            </div>
        </div>
    }
            }
        </div>
    }
}
<ConfirmDialog Visible="@showConfirm" Message="@confirmMsg" OnConfirm="ConfirmDelete" OnCancel="() => showConfirm = false" />
@code {
    [Parameter] public string? connId { get; set; }
    private string activeTab = "connections";
    private List<ConnDto>? connections;
    private ConnDto? selectedConn;
    private List<LibraryDto> libraries = new();
    private bool loadingLibs, syncing, testing, saving;
    private bool showConfirm;
    private string confirmMsg = "Are you sure you want to delete this connection?";
    private int deleteId;
    private string? syncResult, testResult;
    private bool showSavePopup;
    private string? savePopupMsg;
    private System.Threading.Timer? savePopupTimer;
    private int mediaCount;

    // Connection form
    private string newName = "";
    private string newKind = "jellyfin";
    private string newUrl = "";
    private string newApiKey = "";
    private bool creating;
    private string? connMsg;

    // Sync form
    private string syncUrl = "http://localhost:8096";
    private string syncApiKey = "";
    private string syncLibraryId = "";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        int? parsedConnId = int.TryParse(connId, out var ci) ? ci : null;
        if (parsedConnId.HasValue && connections is not null)
        {
            var c = connections.FirstOrDefault(x => x.Id == parsedConnId.Value);
            if (c is not null) await SelectConnection(c);
        }
    }

    private async Task Load()
    {
        try
        {
            connections = await Http.GetFromJsonAsync<List<ConnDto>>("api/connections", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            var catalog = await Http.GetFromJsonAsync<CatalogResponse>("api/media/catalog?limit=1", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            mediaCount = catalog?.Count ?? 0;
        }
        catch { connections = new(); }
    }

    private async Task SelectConnection(ConnDto c)
    {
        selectedConn = c;
        activeTab = $"conn-{c.Id}";
        libraries = new();
        loadingLibs = true;
        try
        {
            var libs = await Http.GetFromJsonAsync<List<LibraryDto>>($"api/media/libraries/{c.Id}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            // Restore saved selections
            var savedLibs = new List<string>();
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(c.ConfigJson);
                if (doc.RootElement.TryGetProperty("selectedLibraries", out var sl))
                {
                    if (sl.ValueKind == System.Text.Json.JsonValueKind.Array)
                        savedLibs = sl.EnumerateArray().Select(e => e.GetString() ?? "").ToList();
                    else if (sl.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var str = sl.GetString() ?? "[]";
                        using var inner = System.Text.Json.JsonDocument.Parse(str);
                        if (inner.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                            savedLibs = inner.RootElement.EnumerateArray().Select(e => e.GetString() ?? "").ToList();
                    }
                }
            }
            catch { }
            if (libs is not null)
                foreach (var l in libs)
                {
                    l.Selected = savedLibs.Contains(l.Id);
                    if (string.IsNullOrEmpty(l.MediaTypeStr)) l.MediaTypeStr = "movie";
                    libraries.Add(l);
                }
            // Set sync URL from connection config
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(c.ConfigJson);
                if (doc.RootElement.TryGetProperty("url", out var url)) syncUrl = url.GetString() ?? syncUrl;
                if (doc.RootElement.TryGetProperty("apiKey", out var key)) syncApiKey = key.GetString() ?? syncApiKey;
            }
            catch { }
        }
        catch { libraries = new(); }
        loadingLibs = false;
    }

    private async Task CreateConnection()
    {
        if (string.IsNullOrWhiteSpace(newName)) { connMsg = "Name is required."; return; }
        creating = true;
        connMsg = null;
        try
        {
            var config = new { url = newUrl, apiKey = newApiKey };
            var configJson = System.Text.Json.JsonSerializer.Serialize(config);
            var res = await Http.PostAsJsonAsync("api/connections", new { Name = newName, Kind = newKind, ConfigJson = configJson });
            if (res.IsSuccessStatusCode)
            {
                connMsg = "Connection added.";
                StateHasChanged();
                newName = ""; newUrl = ""; newApiKey = "";
                await Load();
                StateHasChanged();
            }
            else connMsg = "Error: " + await res.Content.ReadAsStringAsync();
        }
        catch (Exception e) { connMsg = "Error: " + e.Message; }
        StateHasChanged();
        creating = false;
    }

    private void AskDelete(int id) { deleteId = id; showConfirm = true; }
    private async Task ConfirmDelete()
    {
        showConfirm = false;
        await Http.DeleteAsync($"api/connections/{deleteId}");
        if (selectedConn?.Id == deleteId) { selectedConn = null; activeTab = "connections"; }
        await Load();
    }

    private async Task TestConn()
    {
        testing = true;
        testResult = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/media/test-jellyfin", new { Url = syncUrl, ApiKey = syncApiKey });
            var body = await res.Content.ReadAsStringAsync();
            testResult = res.IsSuccessStatusCode ? "OK: " + body : "Error: " + body;
        }
        catch (Exception e) { testResult = "Error: " + e.Message; }
        testing = false;
    }

    private async Task SaveSelected()
    {
        if (selectedConn is null) return;
        saving = true;
        try
        {
            var selected = libraries.Where(l => l.Selected).Select(l => l.Id).ToList();
            // Update connection config with selected libraries
            Dictionary<string, string> config;
            try { config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(selectedConn.ConfigJson) ?? new(); }
            catch { config = new(); }
            config["selectedLibraries"] = System.Text.Json.JsonSerializer.Serialize(selected);
            var updatedConfig = System.Text.Json.JsonSerializer.Serialize(config);
            await Http.PutAsJsonAsync($"api/connections/{selectedConn.Id}", new { Id = selectedConn.Id, Name = selectedConn.Name, Kind = selectedConn.Kind, ConfigJson = updatedConfig });
            syncResult = $"Saved {selected.Count} selected libraries.";
            await Load();
        }
        catch (Exception e) { syncResult = "Error: " + e.Message; }
        saving = false;
    }

    private async Task SyncSelected()
    {
        if (selectedConn is null) return;
        var selected = libraries.Where(l => l.Selected).Select(l => l.Id).ToList();
        if (selected.Count == 0) { syncResult = "No libraries selected."; StateHasChanged(); return; }
        syncing = true;
        syncResult = null;
        try
        {
            var selectedTypes = libraries.Where(l => l.Selected).ToDictionary(l => l.Id, l => l.MediaTypeStr);
            var res = await Http.PostAsJsonAsync("api/media/sync-libraries", new { ConnectionId = selectedConn.Id, LibraryIds = selected, MediaTypes = selectedTypes });
            syncResult = await res.Content.ReadAsStringAsync();
            StateHasChanged();
            await Load();
            StateHasChanged();
        }
        catch (Exception e) { syncResult = "Error: " + e.Message; }
        syncing = false;
    }

    public record ConnDto(int Id, string Name, string Kind, string ConfigJson);
    public class LibraryDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public int MediaType { get; set; }
        public string MediaTypeStr
        {
            get => MediaType switch { 0 => "movie", 1 => "series", 2 => "album", 3 => "artist", 4 => "musicvideo", 5 => "news", _ => "movie" };
            set => MediaType = value switch { "movie" => 0, "series" => 1, "album" => 2, "artist" => 3, "musicvideo" => 4, "news" => 5, _ => 0 };
        }
        public bool Selected { get; set; }
    }
    public class CatalogResponse { public int Count { get; set; } }
}
